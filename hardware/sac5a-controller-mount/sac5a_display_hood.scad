// =============================================================================
//  定刻起床装置 個人簡易型 SAC-5A型  制御タイマー(型式 SUK-49) 用
//  液晶めかくしフード（上からかぶせる蓋）
// -----------------------------------------------------------------------------
//  ・本体の上端に上からスポッとかぶせるキャップ
//  ・前に垂れる「バイザー」が液晶だけを覆う
//  ・アラームボタンも停止A/Bも操作ボタンも、全部バイザーの外に出る
//  ・外すときは真上に持ち上げるだけ
//
//  寸法根拠 : 取扱説明書「制御タイマー 各部名称」図を 800 dpi で描画して実測
//             （120 × 120 の盤面に対し、左端／底面からの mm）
//
//    液晶ディスプレイ  … 左 25.8〜94.4 / 底 69.3〜104.2
//    LED表示(電源/アラーム/停電/エラー) … 左 28.4〜63.7 / 底 56.4〜64.6
//    アラームボタン    … 左 73.1〜93.6 / 底 39.8〜49.2
//    停止ボタンA       … 左  2.6〜19.7 / 底 79〜94
//    停止ボタンB       … 左 99.5〜116.1 / 底 79〜94
//
//  → 液晶は盤面のほぼ中央(中心から ±34.4)、停止ボタンはその外側(±40.3 より外)。
//    バイザーを半幅 37 にすると、液晶を完全に覆ったまま停止A/Bが両方露出する。
//  → バイザー下端を底から 67 にすると、液晶(69.3)は覆い、
//    LED表示(64.6)とアラームボタン(49.2)は見える/押せる。
//
//  座標系 : z = 0 が制御タイマーの上面 / x,y は本体の中心
//           -Y = 表示・ボタン側 / +Y = 背面側
//  単位   : mm
// =============================================================================

$fn = 48;

// --------------------------------------------------- 制御タイマー(SUK-49)
DEV_W = 120;   // 幅   (X)
DEV_D = 60;    // 奥行 (Y)
DEV_H = 120;   // 高さ (Z)

// ------------------------------------------------------------------ はめあい
FIT   = 0.5;   // 片側クリアランス。きつくて入らない→0.7 / ゆるい→0.35

// -------------------------------------------------------------------- 肉厚等
WALL    = 3;   // 側面・背面・バイザーの厚さ
TOP_T   = 3;   // 天板厚
SKIRT_H = 16;  // 本体上端から下へ何mmかぶせるか（この範囲は全周を囲む）

// ------------------------------------------------------------------ バイザー
VISOR_HW     = 37;  // 半幅。液晶(±34.4)を覆い、停止A/B(±40.3〜)を避ける
VISOR_BOTTOM = 67;  // 下端（本体底面からの高さ）
                    //   67 … 液晶だけ覆う。LED表示とアラームボタンは見える(既定)
                    //   53 … LED表示も覆う。アラームボタンはまだ押せる

// -------------------------------------------------------------------- 通気
VENT    = true; // 天板のスリット（通気 + 指がかり）
RIB_H   = 2;    // 天板を本体上面から浮かせるリブの高さ

PLACE_ON_BED = true; // true: 天板を下にして Z=0 に配置（造形向き）

// =============================================================================
//  派生寸法（z = 0 が本体の上面）
// =============================================================================
iw = DEV_W / 2 + FIT;   // 内側 半幅
ow = iw + WALL;         // 外側 半幅
id = DEV_D / 2 + FIT;   // 内側 半奥行
od = id + WALL;         // 外側 半奥行

plate_z0 = RIB_H;            // 天板 下面
plate_z1 = RIB_H + TOP_T;    // 天板 上面
visor_z  = VISOR_BOTTOM - DEV_H;  // バイザー下端（本体上面基準なので負）

module bx(x0, x1, y0, y1, z0, z1)
    translate([min(x0, x1), min(y0, y1), min(z0, z1)])
        cube([abs(x1 - x0), abs(y1 - y0), abs(z1 - z0)]);

// =============================================================================
//  1. キャップ : 本体の上端 SKIRT_H mm を全周囲む箱（下面は開放）
// =============================================================================
module cap() {
    difference() {
        bx(-ow, ow, -od, od, -SKIRT_H, plate_z1);
        bx(-iw, iw, -id, id, -SKIRT_H - 1, plate_z0);
    }
}

// 天板を浮かせるリブ（本体上面に当たる）
module ribs() {
    for (sy = [-1, 1])
        bx(-iw + 2, iw - 2, sy * 18 - 2.5, sy * 18 + 2.5, 0, plate_z0 + 0.5);
}

// =============================================================================
//  2. バイザー : 前面から下へ垂れて液晶だけを覆う
// =============================================================================
module visor() {
    bx(-VISOR_HW, VISOR_HW, -od, -id, visor_z, -SKIRT_H + 1);
}

// =============================================================================
//  3. 天板のスリット（通気と指がかり）
// =============================================================================
module vents() {
    if (VENT)
        for (yc = [-25, -11, 0, 11, 25])   // リブ(±18)に掛からない位置
            bx(-45, 45, yc - 3, yc + 3, plate_z0 - 1, plate_z1 + 1);
}

// =============================================================================
//  組み立て
// =============================================================================
module hood() {
    difference() {
        union() {
            cap();
            ribs();
            visor();
        }
        vents();
    }
}

// 参考表示 : 制御タイマー本体（STL には含まれない）
module device_ghost() {
    %translate([-DEV_W / 2, -DEV_D / 2, -DEV_H])
        cube([DEV_W, DEV_D, DEV_H]);
}

if (PLACE_ON_BED)
    translate([0, 0, plate_z1]) rotate([180, 0, 0]) hood();
else
    hood();
